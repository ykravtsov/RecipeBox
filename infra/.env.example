# Infrastructure Environment Configuration
# Copy this file to .env and update with your actual values

# Deployment environment: dev, staging, or prod
ENVIRONMENT=dev

# GitHub repository URL for ArgoCD GitOps
# Example: https://github.com/your-org/recipebox
GITHUB_REPOSITORY_URL=https://github.com/your-org/recipebox

# PostgreSQL admin password
# Requirements: Minimum 8 characters, must include:
#   - Uppercase letter (A-Z)
#   - Lowercase letter (a-z)
#   - Number (0-9)
#   - Special character (!@#$%^&*)
# Example: MyP@ssw0rd!
POSTGRES_PASSWORD=

# Azure credentials JSON
# Obtain from Azure CLI: az ad sp create-for-rbac --role Contributor
# Format: {"subscriptionId":"...","tenantId":"...","clientId":"...","clientSecret":"..."}
AZURE_CREDENTIALS=
