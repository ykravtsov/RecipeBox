FROM ubuntu:22.04

# Install basic tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Install CDKTF CLI (matching project version)
RUN npm install -g cdktf-cli@0.20.10

# Install Terraform
RUN wget -O terraform.zip https://releases.hashicorp.com/terraform/1.6.6/terraform_1.6.6_linux_amd64.zip && \
    unzip terraform.zip && \
    mv terraform /usr/local/bin/ && \
    rm terraform.zip

# Install Conftest
RUN wget -O conftest.tar.gz https://github.com/open-policy-agent/conftest/releases/download/v0.48.0/conftest_0.48.0_Linux_x86_64.tar.gz && \
    tar -xzf conftest.tar.gz && \
    mv conftest /usr/local/bin/ && \
    rm conftest.tar.gz

# Install Helm
RUN curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Set Node.js memory limit
ENV NODE_OPTIONS="--max-old-space-size=8192"

# Set working directory
WORKDIR /app

# Copy the project
COPY . .

# Install infrastructure dependencies
RUN cd infra && npm install --legacy-peer-deps

# Build infrastructure
RUN cd infra && cdktf get && cdktf synth

# Test CDKTF infrastructure policies
RUN conftest test infra/cdktf.out/stacks/recipebox-infra/ -p policy/terraform.rego

# Test ArgoCD Application policies
RUN helm template recipebox k8s/ | conftest test -p policy/argocd.rego -

# Run Helm chart tests
RUN helm lint k8s/

# Default command
CMD ["echo", "All tests passed!"]